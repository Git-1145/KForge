{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build current + utility all",
            "type": "shell",
            "command": "g++",
            "args": [
                "${file}",
                "./utility/*.cpp",
                "-I${workspaceFolder}",  // <-- 新增：将项目根目录加入头文件搜索路径
                "-o",
                "${file}.exe",
                "-std=c++17",
                "-Wall",
                "-Wextra"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "gcc",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "detail": "编译当前cpp,自动链接utility下全部cpp文件"
        },
        {
            "label": "run app.exe",
            "type": "shell",
            "command": "./app.exe",
            "args": [],
            "dependsOn": "build current + utility all",
            "group": "test"
        }
    ]
}
